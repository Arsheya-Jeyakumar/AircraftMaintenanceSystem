# Aircraft Maintenance & Component Lifecycle Intelligence System
# Database Configuration Template
# Copy this file to 'db.properties' in the project root or configure via environment variables.

db.host=localhost
db.port=3306
db.name=aircraft_maintenance_db
db.username=root
