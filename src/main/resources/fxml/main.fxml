<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aircraft.controller.MainController"
            styleClass="app-container">

    <!-- TOP HEADER BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">
            <VBox spacing="2">
                <Label text="AEROINTEL | Aircraft Maintenance &amp; Lifecycle Intelligence" styleClass="app-title"/>
                <Label text="Database Management System (DBMS) Enterprise Operational Console" styleClass="app-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Database Connection Status & Action Controls -->
            <HBox alignment="CENTER" spacing="12">
                <Label fx:id="dbStatusBadge" text="● Checking Connection..." styleClass="badge, badge-warning"/>
                <Button fx:id="btnReconnect" text="↻ Test Connection" onAction="#handleReconnect" styleClass="btn-secondary, btn-sm"/>
                <Button fx:id="btnRefreshAll" text="🔄 Refresh All" onAction="#handleRefreshAll" styleClass="btn-primary, btn-sm"/>
            </HBox>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR NAVIGATION -->
    <left>
        <VBox spacing="6" prefWidth="250" styleClass="sidebar">
            <Label text="NAVIGATION" styleClass="section-description" style="-fx-font-size: 10px; -fx-padding: 0 0 6 12;"/>

            <Button fx:id="btnNavDashboard" text="📊  Fleet Dashboard" maxWidth="Infinity" onAction="#showDashboardView" styleClass="nav-button, nav-button-active"/>
            <Button fx:id="btnNavFleet" text="✈️  Aircraft Registry" maxWidth="Infinity" onAction="#showFleetView" styleClass="nav-button"/>
            <Button fx:id="btnNavComponents" text="⚙️  Components Catalog" maxWidth="Infinity" onAction="#showComponentsView" styleClass="nav-button"/>
            <Button fx:id="btnNavLifecycle" text="🔄  Installations &amp; Lifecycle" maxWidth="Infinity" onAction="#showLifecycleView" styleClass="nav-button"/>
            <Button fx:id="btnNavMaintenance" text="🛠️  Maintenance Operations" maxWidth="Infinity" onAction="#showMaintenanceView" styleClass="nav-button"/>
            <Button fx:id="btnNavInspections" text="🔍  Inspections &amp; Failures" maxWidth="Infinity" onAction="#showInspectionsView" styleClass="nav-button"/>
            <Button fx:id="btnNavInventory" text="📦  Inventory &amp; Spare Parts" maxWidth="Infinity" onAction="#showInventoryView" styleClass="nav-button"/>
            <Button fx:id="btnNavAlerts" text="🔔  Alerts &amp; Risk Intelligence" maxWidth="Infinity" onAction="#showAlertsView" styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Project Contributors Card -->
            <VBox spacing="4" style="-fx-background-color: #162032; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-radius: 8;">
                <Label text="DBMS PROJECT TEAM" style="-fx-font-weight: bold; -fx-font-size: 10px; -fx-text-fill: #38bdf8;"/>
                <Label text="• Thunga P. (Person 1 - Lifecycle)" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                <Label text="• Arsheya T. J. 25BCE2629 (P2 - Maint)" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                <Label text="• Avandika K. 25BCE2293 (P3 - Inv &amp; Risk)" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN DYNAMIC CONTENT AREA -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <StackPane fx:id="contentContainer" styleClass="content-area"/>
        </ScrollPane>
    </center>

</BorderPane>
